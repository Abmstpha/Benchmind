# Benchmind API Configuration Template
# Copy this file to .env and fill in your actual values

# API Keys (Required)
MISTRAL_API_KEY=your_mistral_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here  # For main agent
GOOGLE_API_KEY=your_google_api_key_here  # For search sub-agent (separate to avoid rate limits)

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Logging
LOG_LEVEL=INFO

# Model Configuration
DEFAULT_GEMINI_MODEL=models/gemini-2.5-flash

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Database
DATABASE_URL=your_postgresql_connection_string_here

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXP_SECONDS=345600

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@benchmind.ai
