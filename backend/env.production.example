# Production Environment Variables for Render Deployment
# Copy these to your Render service environment variables

# Database (Render will provide this automatically)
DATABASE_URL=postgresql://user:password@host:port/database

# Environment
ENVIRONMENT=production

# API Keys (Set these in Render dashboard)
MISTRAL_API_KEY=your_mistral_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_search_api_key_here

# JWT Secret (Generate a secure random string)
JWT_SECRET=your_super_secure_jwt_secret_here

# Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# CORS Origins (Add your frontend domains)
CORS_ORIGINS=https://your-frontend-domain.com,https://benchmind.vercel.app

# Logging
LOG_LEVEL=INFO
